                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Status code is 200\", function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test(\"AI responds politely\", function () {",
                            "    var jsonData = pm.response.json();",
                            "    pm.expect(jsonData.cauTraLoi).to.include.any.of(['xin chào', 'chào', 'xin kính chào']);",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
